# Example .env file for OmniParser configuration
# Copy this file to .env and fill in your values

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# When using LiteLLM/Claude Code proxy, auth token is also read from:
# ANTHROPIC_AUTH_TOKEN=sk-xxxxxx
API_KEY=your_default_api_key_here

# Custom Base URLs (Optional)
CUSTOM_BASE_URL=https://api.openai.com/v1

# Anthropic via LiteLLM proxy (e.g. Claude Code CLI style)
# ANTHROPIC_BASE_URL=https://litellm.prod.aws.lifelock.com
# ANTHROPIC_AUTH_TOKEN=sk-xxxxxx
# ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Custom Model Names (Optional)
CUSTOM_MODEL_NAME=gpt-4o

# Note: If .env file doesn't exist, the fields will be empty by default